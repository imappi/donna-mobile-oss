{
  "name": "donna-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "mock": "node mockserver/server.mjs",
    "test": "tsx --test core/api/*.test.ts core/design/*.test.ts core/i18n/*.test.ts core/screens/*.test.ts src/state/*.test.ts mockserver/*.test.mjs",
    "test:cleanup:live": "node --test mockserver/evals/finnishCleanup.live.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "generate:api": "npx --yes openapi-typescript@7 contract/mobile-api.yaml -o core/api/schema.d.ts"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~57.0.32",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.30",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "yaml": "~2.9.0"
  },
  "license": "Apache-2.0"
}
